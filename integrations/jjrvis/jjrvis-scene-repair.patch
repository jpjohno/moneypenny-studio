diff --git a/jarvis_comm_broker.py b/jarvis_comm_broker.py
--- a/jarvis_comm_broker.py
+++ b/jarvis_comm_broker.py
@@ -1029,0 +1030,19 @@
+
+    from workspace_assets import AssetProfiles
+    asset_profiles = AssetProfiles(HERE / '.runtime/asset-profiles.json')
+
+    @app.get('/v1/workspace/assets', dependencies=secure)
+    def workspace_asset_profiles():
+        try:
+            return asset_profiles.list()
+        except (ValueError, OSError):
+            raise HTTPException(503, 'Saved profiles could not be read')
+
+    @app.post('/v1/workspace/assets', dependencies=secure)
+    def workspace_asset_add(value: dict):
+        try:
+            return asset_profiles.add(value)
+        except ValueError as error:
+            raise HTTPException(422, str(error))
+        except OSError:
+            raise HTTPException(503, 'Profile could not be saved')
