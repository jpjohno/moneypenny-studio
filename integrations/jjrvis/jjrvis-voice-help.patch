+def literal_speech_request(question):
+    """Bounded top-level speech check; embedded/quoted instructions are data."""
+    match = re.fullmatch(r'\s*(?:for a voice check,\s*)?(?:please\s+)?say exactly:\s*(.+?)\s*', question, re.I | re.S)
+    if not match:
+        return None
+    text = match.group(1).strip()
+    return text if 0 < len(text) <= 400 else None
+
+
+def voice_controls_request(question):
+    """Only explicit listening/control help gets the fixed microphone FAQ.
+
+    Voice-related words can instead be quoted content, a read-aloud request,
+    or ordinary conversation. Those still need their requested answer.
+    """
+    lower = question.casefold()
+    if re.search(r"\b(?:say|repeat|read|speak)\s+(?:exactly|only|the following|these words|this (?:phrase|sentence|text)|after me)\b|\b(?:say|repeat|read|speak)\s*:", lower):
+        return False
+    # A quoted question is content to discuss/read, not a control instruction.
+    control = re.sub(r'"[^"\n]*"|“[^”\n]*”|(?<!\w)\'[^\'\n]*\'(?!\w)', '', lower)
+    voice = r'(?:microphone|mic|voice|audio|speech|dictation|conversation|speaking|listening)'
+    return bool(re.search(
+        r'\b(?:how|where)\b.{0,50}\b(?:use|enable|disable|start|stop|turn on|turn off|set up|configure|fix)\b.{0,45}\b'+voice+r'\b|'
+        r'\bhow\s+(?:do|can|should)\s+(?:i|we)\s+(?:speak|talk|listen)\s+(?:to|with|through)\s+(?:you|moneypenny|jarvis|jjrvis)\b|'
+        r'\b(?:where|which|what)\b.{0,30}\b'+voice+r'\b.{0,20}\b(?:button|control|setting|permission)s?\b|'
+        r'\b(?:can|could|do|did)\s+you\s+hear\s+me\b|'
+        r'\b(?:are|were)\s+you\s+listening(?:\s+(?:to me|now))?[?.!\s]*$|'
+        r'\b(?:do|can|will|are)\s+you\s+(?:listen|listening)\s+(?:continuously|all the time|in the background)\b|'
+        r'\b'+voice+r'\b.{0,25}\b(?:not working|doesn[’\']t work|isn[’\']t working|not picking up|unavailable|silent)\b|'
+        r'^\s*(?:there is |there[’\']s )?no (?:sound|audio|voice)[?.!\s]*$', control))
 
