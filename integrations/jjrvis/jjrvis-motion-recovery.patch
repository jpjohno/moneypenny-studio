+const movementPending=new Map();let movementSequence=0;
+function requestPresenceMovement(text,{quiet=false}={}){
+ if(stopped)return Promise.reject(new Error('Unlock JJRVIS first.'));
+ const state=document.querySelector('[data-presence-state]');if(state?.dataset.state!=='ready')return Promise.reject(new Error('Moneypenny is still preparing her 3D stage.'));
